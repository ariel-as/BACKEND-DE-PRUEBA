model Empleado {
  id String @db.VarChar(10) @map("emp_cedula") @id
  cargoId String @db.VarChar(3) @map("crg_codigo")
  turnoId String? @db.VarChar(3) @map("tur_codigo")
  usuarioId Int? @db.Integer @unique @map("usr_codigo")
  nombre String @db.VarChar(60) @map("emp_nombre")
  apellido String @db.VarChar(60) @map("emp_apellido")
  telefono String? @db.VarChar(10) @map("emp_telefono")
  correo String? @db.VarChar(120) @map("emp_correo")
  especialidad String? @db.VarChar(60) @map("emp_especialidad")
  fechaIngreso DateTime @db.Date @map("emp_fecha_ingreso")
  sueldo Decimal? @db.Decimal(10, 2) @map("emp_sueldo")
  estado String @db.Char(1) @map("emp_estado")
  usuario Usuario? @relation("Usuario_Empleado_1", fields: [usuarioId], references: [id])
  cargoIdRef1 Cargo @relation("Cargo_Empleado_1", fields: [cargoId], references: [id])
  turnoIdRef1 Turno? @relation("Turno_Empleado_1", fields: [turnoId], references: [id])
  asistenciaEmpleados AsistenciaEmpleado[] @relation("Empleado_AsistenciaEmpleado_1")
  rutinas Rutina[] @relation("Empleado_Rutina_1")
  inscripcionRef1 Inscripcion[] @relation("Empleado_Inscripcion_1")
  inscripcionRef2 Inscripcion[] @relation("Empleado_Inscripcion_2")
  inscripcionRef3 Inscripcion[] @relation("Empleado_Inscripcion_3")
  suspensionRef1 Suspension[] @relation("Empleado_Suspension_1")
  suspensionRef2 Suspension[] @relation("Empleado_Suspension_2")
  clases Clase[] @relation("Empleado_Clase_1")
  comisionAliados ComisionAliado[] @relation("Empleado_ComisionAliado_1")
  ordenCompraRef1 OrdenCompra[] @relation("Empleado_OrdenCompra_1")
  ordenCompraRef2 OrdenCompra[] @relation("Empleado_OrdenCompra_2")
  kardexs Kardex[] @relation("Empleado_Kardex_1")
  ventaRef1 Venta[] @relation("Empleado_Venta_1")
  ventaRef2 Venta[] @relation("Empleado_Venta_2")
  facturas Factura[] @relation("Empleado_Factura_1")
  pagos Pago[] @relation("Empleado_Pago_1")
  movimientoCajas MovimientoCaja[] @relation("Empleado_MovimientoCaja_1")
  cuadreTurnos CuadreTurno[] @relation("Empleado_CuadreTurno_1")
  cierreCajas CierreCaja[] @relation("Empleado_CierreCaja_1")
  notificacions Notificacion[] @relation("Empleado_Notificacion_1")
  mensajeContactos MensajeContacto[] @relation("Empleado_MensajeContacto_1")
  @@map("empleado")
}
