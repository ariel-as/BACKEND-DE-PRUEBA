model Venta {
  id Int @db.Integer @default(autoincrement()) @map("ven_numero") @id
  clienteId String @db.VarChar(10) @map("cli_cedula")
  empleadoId String @db.VarChar(10) @map("emp_cedula")
  pedidoId Int? @db.Integer @unique @map("ped_numero")
  fecha DateTime @db.Timestamp(6) @default(now()) @map("ven_fecha")
  subtotal Decimal @db.Decimal(10, 2) @map("ven_subtotal")
  descuento Decimal @db.Decimal(10, 2) @map("ven_descuento") @default(0)
  total Decimal @db.Decimal(10, 2) @map("ven_total")
  canal String @db.Char(1) @map("ven_canal")
  estado String @db.Char(1) @map("ven_estado") @default("C")
  empAnulaId String? @db.VarChar(10) @map("ven_emp_anula")
  fechaAnula DateTime? @db.Timestamp(6) @map("ven_fecha_anula")
  motivoAnula String? @db.VarChar(200) @map("ven_motivo_anula")
  kardexs Kardex[] @relation("Venta_Kardex_1")
  pedido Pedido? @relation("Pedido_Venta_1", fields: [pedidoId], references: [id])
  clienteIdRef1 Cliente @relation("Cliente_Venta_1", fields: [clienteId], references: [id])
  empleadoIdRef1 Empleado @relation("Empleado_Venta_1", fields: [empleadoId], references: [id])
  empAnulaIdRef2 Empleado? @relation("Empleado_Venta_2", fields: [empAnulaId], references: [id])
  detalleVentas DetalleVenta[] @relation("Venta_DetalleVenta_1")
  facturas Factura? @relation("Venta_Factura_1")
  pagos Pago[] @relation("Venta_Pago_1")
  @@map("venta")
}
