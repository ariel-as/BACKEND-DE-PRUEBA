model Notificacion {
  id Int @db.Integer @default(autoincrement()) @map("not_numero") @id
  destino String @db.Char(1) @map("not_destino")
  clienteId String? @db.VarChar(10) @map("cli_cedula")
  empleadoId String? @db.VarChar(10) @map("emp_cedula")
  inscripcionId Int? @db.Integer @map("ins_numero")
  pedidoId Int? @db.Integer @map("ped_numero")
  promocionId Int? @db.Integer @map("prm_numero")
  productoId String? @db.VarChar(13) @map("prd_codigo")
  loteProductoId Int? @db.Integer @map("lot_codigo")
  tipo String @db.Char(1) @map("not_tipo")
  mensaje String @db.VarChar(500) @map("not_mensaje")
  fechaEnvio DateTime @db.Timestamp(6) @default(now()) @map("not_fecha_envio")
  canal String @db.Char(1) @map("not_canal")
  estado String @db.Char(1) @map("not_estado")
  promocionIdRef1 Promocion? @relation("Promocion_Notificacion_1", fields: [promocionId], references: [id])
  clienteIdRef1 Cliente? @relation("Cliente_Notificacion_1", fields: [clienteId], references: [id])
  empleadoIdRef1 Empleado? @relation("Empleado_Notificacion_1", fields: [empleadoId], references: [id])
  inscripcionIdRef1 Inscripcion? @relation("Inscripcion_Notificacion_1", fields: [inscripcionId], references: [id])
  pedido Pedido? @relation("Pedido_Notificacion_1", fields: [pedidoId], references: [id])
  producto Producto? @relation("Producto_Notificacion_1", fields: [productoId], references: [id])
  loteProductoIdRef1 LoteProducto? @relation("LoteProducto_Notificacion_1", fields: [loteProductoId], references: [id])
  @@map("notificacion")
}
