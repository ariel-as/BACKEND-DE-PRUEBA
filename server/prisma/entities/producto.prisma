model Producto {
  id String @db.VarChar(13) @map("prd_codigo") @id
  categoriaId String @db.VarChar(4) @map("cat_codigo")
  unidadMedidaId String @db.VarChar(6) @map("unm_codigo")
  nombre String @db.VarChar(100) @map("prd_nombre")
  descripcion String? @db.VarChar(300) @map("prd_descripcion")
  contenido Decimal? @db.Decimal(8, 2) @map("prd_contenido")
  talla String? @db.VarChar(4) @map("prd_talla")
  precioVenta Decimal @db.Decimal(10, 2) @map("prd_precio_venta")
  costoPromedio Decimal @db.Decimal(12, 4) @map("prd_costo_promedio") @default(0)
  pagaIva String @db.Char(1) @map("prd_paga_iva")
  stock Int @db.Integer @map("prd_stock") @default(0)
  stockMin Int @db.Integer @map("prd_stock_min")
  esContable String @db.Char(1) @map("prd_es_contable")
  controlaCaducidad String @db.Char(1) @map("prd_controla_caducidad")
  diasAlertaCad Int? @db.Integer @map("prd_dias_alerta_cad")
  metodoSalida String @db.Char(1) @map("prd_metodo_salida")
  metodoValora String @db.Char(1) @map("prd_metodo_valora") @default("P")
  publicarWeb String @db.Char(1) @map("prd_publicar_web")
  fechaCreacion DateTime @db.Timestamp(6) @default(now()) @map("prd_fecha_creacion")
  estado String @db.Char(1) @map("prd_estado")
  categoria Categoria @relation("Categoria_Producto_1", fields: [categoriaId], references: [id])
  unidadMedida UnidadMedida @relation("UnidadMedida_Producto_1", fields: [unidadMedidaId], references: [id])
  productoProveedors ProductoProveedor[] @relation("Producto_ProductoProveedor_1")
  productoOrdenCompras ProductoOrdenCompra[] @relation("Producto_ProductoOrdenCompra_1")
  loteProductos LoteProducto[] @relation("Producto_LoteProducto_1")
  detalles PedidoDetalle[] @relation("Producto_PedidoDetalle_1")
  detalleVentas DetalleVenta[] @relation("Producto_DetalleVenta_1")
  notificacions Notificacion[] @relation("Producto_Notificacion_1")
  @@map("producto")
}
