model Cliente {
  id String @db.VarChar(10) @map("cli_cedula") @id
  nivelId String? @db.VarChar(3) @map("niv_codigo")
  usuarioId Int? @db.Integer @unique @map("usr_codigo")
  nombre String @db.VarChar(60) @map("cli_nombre")
  apellido String @db.VarChar(60) @map("cli_apellido")
  ruc String? @db.VarChar(13) @map("cli_ruc")
  direccion String? @db.VarChar(200) @map("cli_direccion")
  telefono String? @db.VarChar(10) @map("cli_telefono")
  correo String? @db.VarChar(120) @map("cli_correo")
  sector String? @db.VarChar(100) @map("cli_sector")
  fechaNacimiento DateTime? @db.Date @map("cli_fecha_nacimiento")
  esEstudiante String @db.Char(1) @map("cli_es_estudiante") @default("N")
  fechaRegistro DateTime @db.Timestamp(6) @default(now()) @map("cli_fecha_registro")
  estado String @db.Char(1) @map("cli_estado")
  usuario Usuario? @relation("Usuario_Cliente_1", fields: [usuarioId], references: [id])
  nivelIdRef1 Nivel? @relation("Nivel_Cliente_1", fields: [nivelId], references: [id])
  rutinas Rutina[] @relation("Cliente_Rutina_1")
  inscripcionClientes InscripcionCliente[] @relation("Cliente_InscripcionCliente_1")
  ventas Venta[] @relation("Cliente_Venta_1")
  facturas Factura[] @relation("Cliente_Factura_1")
  notificacions Notificacion[] @relation("Cliente_Notificacion_1")
  @@map("cliente")
}
