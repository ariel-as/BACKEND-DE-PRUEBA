model Inscripcion {
  id Int @db.Integer @default(autoincrement()) @map("ins_numero") @id
  membresiaId String @db.VarChar(4) @map("mem_codigo")
  promocionId Int? @db.Integer @map("prm_numero")
  empleadoId String? @db.VarChar(10) @map("emp_cedula")
  empAutorizaId String? @db.VarChar(10) @map("ins_emp_autoriza")
  fechaAutoriza DateTime? @db.Timestamp(6) @map("ins_fecha_autoriza")
  fechaRegistro DateTime @db.Timestamp(6) @default(now()) @map("ins_fecha_registro")
  fechaInicio DateTime @db.Date @map("ins_fecha_inicio")
  fechaFin DateTime? @db.Date @map("ins_fecha_fin")
  ingresosTotal Int? @db.Integer @map("ins_ingresos_total")
  precioBase Decimal @db.Decimal(10, 2) @map("ins_precio_base")
  descuento Decimal @db.Decimal(10, 2) @map("ins_descuento") @default(0)
  valor Decimal @db.Decimal(10, 2) @map("ins_valor")
  porcentajeIva Decimal @db.Decimal(5, 2) @map("ins_porcentaje_iva")
  canal String @db.Char(1) @map("ins_canal")
  estado String @db.Char(1) @map("ins_estado")
  empAnulaId String? @db.VarChar(10) @map("ins_emp_anula")
  fechaAnula DateTime? @db.Timestamp(6) @map("ins_fecha_anula")
  motivoAnula String? @db.VarChar(200) @map("ins_motivo_anula")
  membresiaIdRef1 Membresia @relation("Membresia_Inscripcion_1", fields: [membresiaId], references: [id])
  promocionIdRef1 Promocion? @relation("Promocion_Inscripcion_1", fields: [promocionId], references: [id])
  empleadoIdRef1 Empleado? @relation("Empleado_Inscripcion_1", fields: [empleadoId], references: [id])
  empAutorizaIdRef2 Empleado? @relation("Empleado_Inscripcion_2", fields: [empAutorizaId], references: [id])
  empAnulaIdRef3 Empleado? @relation("Empleado_Inscripcion_3", fields: [empAnulaId], references: [id])
  inscripcionClientes InscripcionCliente[] @relation("Inscripcion_InscripcionCliente_1")
  suspensions Suspension[] @relation("Inscripcion_Suspension_1")
  facturas Factura? @relation("Inscripcion_Factura_1")
  pagos Pago[] @relation("Inscripcion_Pago_1")
  notificacions Notificacion[] @relation("Inscripcion_Notificacion_1")
  @@map("inscripcion")
}
