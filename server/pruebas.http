@base = http://localhost:5050/api/v1
@admin = admin@planetafitness.ec
@cliente = cliente@planetafitness.ec

### Salud
GET {{base}}/salud

### Login administrador
# @name loginAdmin
POST {{base}}/auth/login
Content-Type: application/json

{"correo":"{{admin}}","contrasena":"Admin12345"}

### Crear producto (debe responder 201 y devolver Location)
# @name nuevoProducto
POST {{base}}/productos
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{"id":"PFHTTP01","nombre":"Producto de evidencia","categoriaId":"SUP","unidadMedidaId":"UND","precio":10,"stock":0,"stockMin":1,"pagaIva":"S","esContable":"S","controlaCaducidad":"N","publicarWeb":"S","estado":"A"}

### Login cliente
# @name loginCliente
POST {{base}}/auth/login
Content-Type: application/json

{"correo":"{{cliente}}","contrasena":"Cliente12345"}

### Crear producto con cliente (debe responder 403)
POST {{base}}/productos
Authorization: Bearer {{loginCliente.response.body.token}}
Content-Type: application/json

{"id":"PFHTTP02","nombre":"No permitido","categoriaId":"SUP","precio":10}

### Catálogo público
GET {{base}}/productos?page=1&limit=10

### Confirmar pedido (usa el precio guardado en la base)
# @name nuevoPedido
POST {{base}}/pedidos
Authorization: Bearer {{loginCliente.response.body.token}}
Content-Type: application/json

{"metodoPago":"EF","items":[{"productoId":"PF0001","cantidad":1,"precio":0.01}]}

### Mis pedidos
GET {{base}}/pedidos/mis-pedidos
Authorization: Bearer {{loginCliente.response.body.token}}

### Todos los pedidos con administrador
GET {{base}}/pedidos
Authorization: Bearer {{loginAdmin.response.body.token}}

### Todos los pedidos con cliente (debe responder 403)
GET {{base}}/pedidos
Authorization: Bearer {{loginCliente.response.body.token}}

### Ruta protegida sin token (debe responder 401)
GET {{base}}/pedidos/mis-pedidos

### Registro de cliente nuevo
# @name registroCliente
POST {{base}}/auth/register
Content-Type: application/json

{"cedula":"1700000001","nombre":"Cliente","apellido":"Evidencia","correo":"evidencia.backend@example.ec","telefono":"0997654321","nivelId":"PRI","contrasena":"Prueba12345"}

### Inscripción web
POST {{base}}/inscripciones
Authorization: Bearer {{registroCliente.response.body.token}}
Content-Type: application/json

{"membresiaId":"MI1"}

### Tablas para administración
GET {{base}}/admin/tablas
Authorization: Bearer {{loginAdmin.response.body.token}}

### Metadatos de producto
GET {{base}}/admin/tablas/producto/meta
Authorization: Bearer {{loginAdmin.response.body.token}}

############ FASE 2 ############
@adm = Bearer {{loginAdmin.response.body.token}}

### Login recepción (REC)
# @name loginRec
POST {{base}}/auth/login
Content-Type: application/json

{"correo":"recepcion@planetafitness.ec","contrasena":"Recepcion12345"}

### Login contadora (CON)
# @name loginCon
POST {{base}}/auth/login
Content-Type: application/json

{"correo":"contadora@planetafitness.ec","contrasena":"Contadora12345"}

### Login entrenador (ENT)
# @name loginEnt
POST {{base}}/auth/login
Content-Type: application/json

{"correo":"entrenador@planetafitness.ec","contrasena":"Entrenador12345"}

### Mi sesión con permisos
GET {{base}}/auth/me
Authorization: Bearer {{loginRec.response.body.token}}

### 4.1 Cuentas con roles y vínculo (ADM)
GET {{base}}/admin/usuarios?buscar=planetafitness
Authorization: {{adm}}

### 4.1 Cambiar correo o contraseña
PUT {{base}}/admin/usuarios/3
Authorization: {{adm}}
Content-Type: application/json

{"contrasena":"Recepcion12345"}

### 4.1 Reemplazar roles activos
PUT {{base}}/admin/usuarios/3/roles
Authorization: {{adm}}
Content-Type: application/json

{"roles":["REC"]}

### 4.2 Datos del gimnasio
GET {{base}}/admin/gimnasio
Authorization: Bearer {{loginRec.response.body.token}}

### 4.2 Editar aforo e IVA (solo ADM)
PUT {{base}}/admin/gimnasio
Authorization: {{adm}}
Content-Type: application/json

{"aforoMax":75,"porcentajeIva":15}

### 4.2 Horario de atención
GET {{base}}/admin/gimnasio/horario
Authorization: {{adm}}

### 4.2 Reemplazar horario de atención
PUT {{base}}/admin/gimnasio/horario
Authorization: {{adm}}
Content-Type: application/json

{"dias":[{"dia":"Lunes a viernes","abierto":"S","horaApertura":"06:00","horaCierre":"21:00"},{"dia":"Sábado","abierto":"S","horaApertura":"09:00","horaCierre":"12:00"},{"dia":"Domingo","abierto":"N"}]}

### 4.9 Abrir turno de caja (REC)
POST {{base}}/admin/caja/turnos
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"turnoId":"MAN","saldoInicial":20}

### 4.9 Turno abierto con movimientos y totales en vivo
GET {{base}}/admin/caja/turnos/actual
Authorization: Bearer {{loginRec.response.body.token}}

### 4.9 Gasto manual
POST {{base}}/admin/caja/movimientos
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"tipo":"EGR","concepto":"Compra de útiles de limpieza","monto":5}

### 4.9 Cuadre del turno (efectivoContado obligatorio)
PATCH {{base}}/admin/caja/turnos/1/cuadre
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"efectivoContado":14}

### 4.9 Cuadres por rango
GET {{base}}/admin/caja/turnos?desde=2026-11-01&hasta=2026-11-30
Authorization: Bearer {{loginCon.response.body.token}}

### 4.9 Cierre semanal (CON)
POST {{base}}/admin/caja/cierres
Authorization: Bearer {{loginCon.response.body.token}}
Content-Type: application/json

{"fechaDesde":"2026-11-16","fechaHasta":"2026-11-22","observacion":"Semana 47"}

### 4.9 Lista de cierres
GET {{base}}/admin/caja/cierres
Authorization: Bearer {{loginCon.response.body.token}}

### 4.10 Reportar transferencia (P→R, comprobante obligatorio)
PATCH {{base}}/pedidos/1/estado
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"estado":"R","refTransferencia":"BANCO-1234"}

### 4.10 Convertir en venta (R→C o P→C); pagos opcional, por defecto el método del pedido
PATCH {{base}}/pedidos/1/estado
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"estado":"C","pagos":[{"metodoPago":"TR","monto":23.00,"referencia":"BANCO-1234"}]}

### 4.10 Entregar (C→E)
PATCH {{base}}/pedidos/1/estado
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"estado":"E"}

### 4.4 Buscar clientes
GET {{base}}/admin/clientes?buscar=Prueba
Authorization: Bearer {{loginRec.response.body.token}}

### 4.4 Crear cliente (REC)
POST {{base}}/admin/clientes
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"cedula":"1710034065","nombre":"Ana","apellido":"Pérez","nivelId":"PRI","telefono":"0991234567","correo":"ana@correo.ec"}

### 4.4 Editar cliente
PUT {{base}}/admin/clientes/1710034065
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"sector":"Norte","ruc":"1710034065001"}

### 4.4 Historial del cliente
GET {{base}}/admin/clientes/1712345675/historial
Authorization: Bearer {{loginRec.response.body.token}}

### 4.6 Inscribir y cobrar en el local (dos métodos)
POST {{base}}/admin/inscripciones
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"clienteId":"1710034065","membresiaId":"MI2","pagos":[{"metodoPago":"EF","monto":40},{"metodoPago":"TR","monto":20,"referencia":"TRX-5555"}]}

### 4.6 Inscripción con promoción que pide autorización
POST {{base}}/admin/inscripciones
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"clienteId":"1710034065","membresiaId":"MI2","promocionId":1,"empAutorizaId":"1711111110","pagos":[{"metodoPago":"EF","monto":54}]}

### 4.6 Lista con filtros
GET {{base}}/admin/inscripciones?estado=A&canal=L
Authorization: Bearer {{loginRec.response.body.token}}

### 4.6 Detalle
GET {{base}}/admin/inscripciones/1
Authorization: Bearer {{loginRec.response.body.token}}

### 4.6 Cobrar inscripción web pendiente
POST {{base}}/admin/inscripciones/1/cobrar
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"pagos":[{"metodoPago":"EF","monto":35}]}

### 4.6 Agregar acompañante
POST {{base}}/admin/inscripciones/1/integrantes
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"clienteId":"1700000084"}

### 4.6 Quitar acompañante sin entradas
DELETE {{base}}/admin/inscripciones/1/integrantes/1700000084
Authorization: Bearer {{loginRec.response.body.token}}

### 4.6 Renovar
POST {{base}}/admin/inscripciones/1/renovar
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"pagos":[{"metodoPago":"EF","monto":60}]}

### 4.7 Acceso por cédula: inscripciones activas y clases de hoy
GET {{base}}/admin/clientes/1712345675/acceso
Authorization: Bearer {{loginRec.response.body.token}}

### 4.7 Registrar entrada (con clase opcional)
POST {{base}}/admin/entradas
Authorization: Bearer {{loginRec.response.body.token}}
Content-Type: application/json

{"clienteId":"1712345675","inscripcionId":1,"claseId":1,"horarioId":1}

### 4.7 Registrar salida
PATCH {{base}}/admin/entradas/1/salida
Authorization: Bearer {{loginRec.response.body.token}}

### 4.7 Entradas de un día (abiertas)
GET {{base}}/admin/entradas?fecha=2026-11-22&abiertas=S
Authorization: Bearer {{loginRec.response.body.token}}

### 4.7 Aforo actual
GET {{base}}/admin/aforo
Authorization: Bearer {{loginEnt.response.body.token}}

### 4.11 Venta en mostrador (descuento por línea opcional)
