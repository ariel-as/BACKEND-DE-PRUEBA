NODE_ENV=development
PORT=5050
DATABASE_URL=postgresql://planeta_app:clave@localhost:5432/planeta_fitness?schema=public
JWT_SECRET=cambia-este-valor-por-una-clave-aleatoria
JWT_EXPIRES_IN=2h
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
JSON_LIMIT=100kb
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
BCRYPT_ROUNDS=12
# Tarea diaria: token que el workflow envía en la cabecera X-Tarea-Token (valor largo y aleatorio).
TAREAS_TOKEN=
HTTPS=false
HTTPS_KEY=./certs/localhost-key.pem
HTTPS_CERT=./certs/localhost.pem
SEED_ADMIN_PASSWORD=Admin12345
SEED_CLIENTE_PASSWORD=Cliente12345
SEED_RECEPCION_PASSWORD=Recepcion12345
SEED_ENTRENADOR_PASSWORD=Entrenador12345
SEED_CONTADORA_PASSWORD=Contadora12345
# Directorio del build del frontend servido por Express (opcional)
FRONTEND_DIR=../frontend
