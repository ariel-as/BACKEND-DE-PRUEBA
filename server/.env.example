NODE_ENV=development
PORT=5050
DATABASE_URL=postgresql://planeta_app:clave@localhost:5432/planeta_fitness?schema=public
JWT_SECRET=reemplaza-por-una-cadena-aleatoria-de-al-menos-48-bytes
JWT_EXPIRES_IN=2h
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
JSON_LIMIT=100kb
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
